<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>EST | Photo & Video Archive</title><meta name="description" content="Two videos and 22 photographs from the EST showroom and warehouse in Japan."><link rel="canonical" href="https://jpbuildest.com/media.html"><link rel="icon" href="favicon.svg"><link rel="stylesheet" href="media.css?v=20260924-2"></head><body>
<header class="media-header"><div class="media-shell"><a class="media-logo" href="index.html" aria-label="EST home">EST<span>.</span></a><a class="media-back" href="index.html" data-t="back">← Back to home</a><label class="media-lang"><span class="sr-only" data-t="lang">Language</span><select id="mediaLang" aria-label="Language"><option value="en">English</option><option value="zh">中文</option><option value="hi">हिन्दी</option><option value="es">Español</option><option value="fr">Français</option><option value="mn">Монгол</option></select></label></div></header>
<main><div class="media-shell"><section class="media-lead"><span class="media-eyebrow" data-t="eyebrow">EST PHOTO & VIDEO ARCHIVE</span><h1 data-t="title">See the work in Japan.</h1><p data-t="intro">Two short videos and 22 photographs from the showroom and warehouse. Open any photograph to see it without cropping.</p><div class="media-jumps"><a href="#videos" data-t="videos">Videos</a><a href="#photos" data-t="photos">Photographs</a></div></section>
<section id="videos" class="media-section"><div class="media-section-head"><h2 data-t="videos">Videos</h2><p data-t="videosIntro">Two short recordings from the site. Play when ready.</p></div><div class="media-video-grid"><figure><video controls playsinline preload="none" poster="img/japan-showroom-kitchen-island_s.webp"><source src="video/showroom.mp4" type="video/mp4"></video><figcaption data-t="showroomVideo">Showroom walkthrough</figcaption></figure><figure><video controls playsinline preload="none" poster="img/japan-warehouse-forklift-panels_s.webp"><source src="video/warehouse.mp4" type="video/mp4"></video><figcaption data-t="warehouseVideo">Warehouse walkthrough</figcaption></figure></div></section>
<section id="photos" class="media-section"><div class="media-section-head"><h2 data-t="photos">Photographs</h2><p data-t="photosIntro">Browse every available site photograph by subject.</p></div><div class="photo-group" id="kitchen"><div class="photo-group-head"><h3 data-t="kitchen">Kitchen displays</h3><span>07 / 22</span></div><div class="photo-grid"><figure><a href="img/japan-showroom-kitchen-island.webp" class="photo-link" data-en="Kitchen island" data-zh="厨房岛台" data-group="kitchen"><img src="img/japan-showroom-kitchen-island_s.webp" alt="Kitchen island" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Kitchen island</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-run.webp" class="photo-link" data-en="Linear kitchen display" data-zh="一字型厨房" data-group="kitchen"><img src="img/japan-showroom-kitchen-run_s.webp" alt="Linear kitchen display" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Linear kitchen display</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-stella.webp" class="photo-link" data-en="Compact kitchen display" data-zh="紧凑型厨房" data-group="kitchen"><img src="img/japan-showroom-kitchen-stella_s.webp" alt="Compact kitchen display" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Compact kitchen display</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-compact.webp" class="photo-link" data-en="Small kitchen display" data-zh="小户型厨房" data-group="kitchen"><img src="img/japan-showroom-kitchen-compact_s.webp" alt="Small kitchen display" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Small kitchen display</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-island-dark.webp" class="photo-link" data-en="Dark finish kitchen" data-zh="深色饰面厨房" data-group="kitchen"><img src="img/japan-showroom-kitchen-island-dark_s.webp" alt="Dark finish kitchen" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Dark finish kitchen</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-toclas.webp" class="photo-link" data-en="Wood finish kitchen" data-zh="木色厨房展示" data-group="kitchen"><img src="img/japan-showroom-kitchen-toclas_s.webp" alt="Wood finish kitchen" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Wood finish kitchen</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-kitchen-wood.webp" class="photo-link" data-en="Kitchen worktop and storage" data-zh="厨房台面与收纳" data-group="kitchen"><img src="img/japan-showroom-kitchen-wood_s.webp" alt="Kitchen worktop and storage" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Kitchen worktop and storage</span><span aria-hidden="true">↗</span></figcaption></a></figure></div></div><div class="photo-group" id="bath"><div class="photo-group-head"><h3 data-t="bath">Bathroom displays</h3><span>06 / 22</span></div><div class="photo-grid"><figure><a href="img/japan-showroom-bath-marble.webp" class="photo-link" data-en="Stone finish bathroom module" data-zh="石纹浴室模块" data-group="bath"><img src="img/japan-showroom-bath-marble_s.webp" alt="Stone finish bathroom module" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Stone finish bathroom module</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-bath-display.webp" class="photo-link" data-en="Bath display" data-zh="浴缸展示" data-group="bath"><img src="img/japan-showroom-bath-display_s.webp" alt="Bath display" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Bath display</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-bath-module.webp" class="photo-link" data-en="Bathroom module" data-zh="卫浴模块" data-group="bath"><img src="img/japan-showroom-bath-module_s.webp" alt="Bathroom module" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Bathroom module</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-bath-rakuvia.webp" class="photo-link" data-en="Bathroom configuration" data-zh="浴室配置" data-group="bath"><img src="img/japan-showroom-bath-rakuvia_s.webp" alt="Bathroom configuration" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Bathroom configuration</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-bath-selevia.webp" class="photo-link" data-en="Shower and bath setting" data-zh="淋浴与浴缸组合" data-group="bath"><img src="img/japan-showroom-bath-selevia_s.webp" alt="Shower and bath setting" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Shower and bath setting</span><span aria-hidden="true">↗</span></figcaption></a></figure><figure><a href="img/japan-showroom-bath-unit.webp" class="photo-link" data-en="Unit bathroom" data-zh="整体浴室" data-group="bath"><img src="img/japan-showroom-bath-unit_s.webp" alt="Unit bathroom" loading="lazy" width="570" height="760"><figcaption><span class="photo-caption">Unit bathroom</span><span aria-hidden="true">↗</span></figcaption></a></figure></div></div><div class="photo-group" id="details"><div class="photo-group-head"><h3 data-t="details">Showroom details</h3><span>04 / 22</span></div><div class="photo-grid"><figure><a href="img/japan-showroom-sample-library.webp" class="photo-link" data-en="Material samples and catalogues" data-zh="材料样本与图册" data-group="details"><img src="img/japan-showroom-sample-library_s.webp" alt="Material samples and catalogues" loading="lazy" width="570" height="760"><figcaption><spa